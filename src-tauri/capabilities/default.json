{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права приложения osu!cup",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "core:window:allow-start-dragging"
    },
    {
      "identifier": "core:webview:allow-create-webview-window"
    },
    {
      "identifier": "core:window:allow-set-focus"
    }
  ]
}
